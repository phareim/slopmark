# Copy to .env and fill in secrets. Never commit .env.
# Port the server listens on (127.0.0.1).
SLOPMARK_PORT=3029
# Required: Bearer token the Chrome extension must send.
SLOPMARK_KEY=change-me
# Required: TypeSafe Jev API key (read by src/typesafe.mjs).
TYPESAFE_API_KEY=
# Flag passages with p_ai >= this threshold.
SLOPMARK_THRESHOLD=0.95
# Max fresh Jev calls per UTC day; misses beyond this get daily_limit.
SLOPMARK_DAILY_LIMIT=5000
# Max parallel Jev calls for cache misses in one batch.
SLOPMARK_CONCURRENCY=6
